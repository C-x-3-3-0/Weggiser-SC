---
import { Image } from 'astro:assets';
import wscLogo from '../assets/brand/wsc-logo.png';

const nav = [
  { label: 'Willkommen', href: '/' },
  { label: 'Aktuelles', href: '/aktuelles' },
  { label: 'Mannschaften', href: '/mannschaften' },
  { label: 'Verein', href: '/verein' },
  { label: 'Weiherstübli', href: '/weiherstuebli' },
  { label: 'Arena', href: '/arena' },
  { label: 'Archiv', href: '/archiv' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Weggiser Sportclub – Startseite">
      <span class="logo-chip">
        <Image src={wscLogo} alt="Weggiser Sportclub – Logo" width={120} height={83} format="png" />
      </span>
    </a>
    <nav aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--wsc-brand-primary);
    color: var(--wsc-brand-on-primary);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wsc-space-3);
    padding-top: var(--wsc-space-2);
    padding-bottom: var(--wsc-space-2);
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: var(--wsc-space-1);
    color: var(--wsc-brand-on-primary);
    text-decoration: none;
  }
  .logo-chip {
    display: flex;
    align-items: center;
    background: var(--wsc-paper);
    border-radius: var(--wsc-radius);
    padding: 0.4rem 0.6rem;
  }
  .logo-chip :global(img) {
    display: block;
    height: 40px;
    width: auto;
  }
  @media (min-width: 640px) {
    .logo-chip :global(img) { height: 48px; }
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wsc-space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--wsc-brand-on-primary);
    font-size: var(--wsc-step--1);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 600;
  }
  nav a:hover { text-decoration: underline; }
</style>

---
interface Props {
  label: string;
  compact?: boolean;
}

const { label, compact = false } = Astro.props;
---
<div class={`team-photo-placeholder ${compact ? 'is-compact' : ''}`} role="img" aria-label={`Teamfoto ${label} folgt`}>
  <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="120" height="80" fill="var(--wsc-surface)" />
    <circle cx="42" cy="34" r="12" fill="var(--wsc-line)" />
    <circle cx="70" cy="30" r="9" fill="var(--wsc-line)" />
    <circle cx="90" cy="35" r="10" fill="var(--wsc-line)" />
    <path d="M20 66c3-14 13-21 22-21s17 6 20 15c3-10 11-15 19-15 9 0 17 7 20 21H20Z" fill="var(--wsc-line)" />
  </svg>
  {!compact && <span class="placeholder-label">Teamfoto folgt</span>}
</div>

<style>
  .team-photo-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--wsc-surface);
    border: 1px solid var(--wsc-line);
    border-radius: var(--wsc-radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .team-photo-placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .placeholder-label {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.85);
    color: var(--wsc-muted);
    font-size: var(--wsc-step--1);
    font-weight: 600;
    padding: 0.3em 0.9em;
    border-radius: var(--wsc-radius-pill);
  }
  .is-compact { aspect-ratio: 4 / 3; }
</style>

---
interface Props {
  name: string;
  role?: string;
}

const { name, role } = Astro.props;
---
<div class="person-card">
  <div class="portrait" aria-hidden="true">
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="32" cy="32" r="32" fill="var(--wsc-surface)" />
      <circle cx="32" cy="25" r="12" fill="var(--wsc-line)" />
      <path d="M8 60c2.5-13 11.5-20 24-20s21.5 7 24 20" fill="var(--wsc-line)" />
    </svg>
  </div>
  <p class="person-name">{name}</p>
  {role && <p class="person-role">{role}</p>}
</div>

<style>
  .person-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
  }
  .portrait {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--wsc-line);
    background: var(--wsc-surface);
  }
  .portrait svg { display: block; width: 100%; height: 100%; }
  .person-name { margin: 0; font-weight: 700; }
  .person-role {
    margin: 0;
    font-size: var(--wsc-step--1);
    color: var(--wsc-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>

---
import SponsorStrip from './SponsorStrip.astro';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <SponsorStrip />

    <div class="footer-grid">
      <div>
        <h3>Weggiser Sportclub</h3>
        <p>Thermoplan-Platz 3<br />6353 Weggis</p>
        <p><a href="mailto:info@weggisersc.ch">info@weggisersc.ch</a></p>
      </div>
      <div>
        <h3>Spielbetrieb</h3>
        <ul class="plain">
          <li><a href="https://matchcenter.ifv.ch/default.aspx?v=381&oid=7&lng=1&a=as" rel="noopener">Spielbetrieb</a></li>
          <li><a href="https://matchcenter.ifv.ch/default.aspx?v=381&oid=7&lng=1&a=rr" rel="noopener">Ranglisten</a></li>
          <li><a href="/aktuelles/team-news">Team News</a></li>
        </ul>
      </div>
      <div>
        <h3>Social</h3>
        <ul class="plain">
          <li><a href="https://instagram.com/weggiser_sportclub" rel="noopener">Instagram</a></li>
          <li><a href="https://facebook.com" rel="noopener">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <span>&copy; {year} Weggiser Sportclub</span>
      <a href="/impressum">Impressum</a>
      <span aria-hidden="true">|</span>
      <a href="/datenschutz">Datenschutz</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--wsc-surface);
    border-top: 1px solid var(--wsc-line);
    margin-top: var(--wsc-space-8);
    padding: var(--wsc-space-6) 0 var(--wsc-space-4);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--wsc-space-4);
    margin: var(--wsc-space-4) 0;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plain li { margin-bottom: var(--wsc-space-1); }
  .legal {
    display: flex;
    gap: var(--wsc-space-2);
    align-items: center;
    flex-wrap: wrap;
    color: var(--wsc-muted);
    font-size: var(--wsc-step--1);
    border-top: 1px solid var(--wsc-line);
    padding-top: var(--wsc-space-3);
  }
  .legal a { color: var(--wsc-muted); }
</style>

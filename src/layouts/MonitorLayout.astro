---
import '../styles/tokens.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1920, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--wsc-tv-bg);
        color: var(--wsc-tv-text);
        font-family: var(--wsc-font-body);
        overflow: hidden;
        cursor: none;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

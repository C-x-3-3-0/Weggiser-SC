---
import MonitorLayout from '../layouts/MonitorLayout.astro';
import { Image } from 'astro:assets';
import wscLogo from '../assets/brand/wsc-logo.png';
import matchdaySeed from '../../public/data/matchday.json';
---
<MonitorLayout title="Matchday – Weggiser Sportclub">
  <div class="monitor">
    <header class="monitor-header">
      <div class="brand">
        <Image src={wscLogo} alt="Weggiser Sportclub – Logo" width={320} height={222} format="png" />
      </div>
      <div class="clock-block">
        <div id="clock" class="clock tabular">--:--</div>
        <div id="date" class="date">—</div>
      </div>
    </header>

    <main class="content" id="content" data-seed={JSON.stringify(matchdaySeed.matches)}></main>

    <footer class="stand">Stand: <span id="stand" class="tabular">{matchdaySeed.generatedAt}</span></footer>
  </div>
</MonitorLayout>

<script>
  interface Match {
    time: string;
    home: string;
    away: string;
    field: 'Thermoplan Arena' | 'Black&White Arena';
    garderobeHeim: string;
    garderobeGast: string;
    status: 'live' | 'verschoben' | 'abgesagt' | null;
  }

  // A match is the "main" match from 60 min before to 90 min after kickoff.
  // Overlapping windows (the next match starts within the current one's
  // window) are shown side by side instead of replacing each other.
  const WINDOW_BEFORE_MS = 60 * 60_000;
  const WINDOW_AFTER_MS = 90 * 60_000;

  const PITCH_CLASS: Record<Match['field'], string> = {
    'Thermoplan Arena': 'pill--natural',
    'Black&White Arena': 'pill--artificial',
  };
  const STATUS_LABEL: Record<string, string> = {
    live: 'LIVE',
    verschoben: 'Verschoben',
    abgesagt: 'Abgesagt',
  };
  const STATUS_CLASS: Record<string, string> = {
    live: 'pill--success',
    verschoben: 'pill--warning',
    abgesagt: 'pill--danger',
  };

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] ?? c));
  }

  function kickoffOn(time: string, base: Date): Date {
    const [h, m] = time.split(':').map(Number);
    const d = new Date(base);
    d.setHours(h, m, 0, 0);
    return d;
  }

  function classify(matches: Match[], now: Date) {
    const withWindow = matches
      .map((m) => {
        const kickoff = kickoffOn(m.time, now);
        return {
          m,
          kickoff,
          start: new Date(kickoff.getTime() - WINDOW_BEFORE_MS),
          end: new Date(kickoff.getTime() + WINDOW_AFTER_MS),
        };
      })
      .sort((a, b) => a.kickoff.getTime() - b.kickoff.getTime());

    const main = withWindow.filter((x) => now >= x.start && now <= x.end);
    const mainTimes = new Set(main.map((x) => x.m.time));
    const upcoming = withWindow.filter((x) => !mainTimes.has(x.m.time) && now < x.start);
    const over = withWindow.filter((x) => !mainTimes.has(x.m.time) && now >= x.end);

    return { main: main.map((x) => x.m), upcoming: upcoming.map((x) => x.m), over };
  }

  function pillHtml(m: Match): string {
    const hint = m.field === 'Black&White Arena'
      ? '<span class="hint">Keine Stollenschuhe</span>'
      : '';
    const statusPill = m.status
      ? `<span class="pill ${STATUS_CLASS[m.status]}">${STATUS_LABEL[m.status]}</span>`
      : '';
    return `<span class="pill ${PITCH_CLASS[m.field]}">${escapeHtml(m.field)}</span>${hint}${statusPill}`;
  }

  function mainCardHtml(m: Match): string {
    const dimmed = m.status === 'abgesagt';
    return `
      <div class="main-card ${dimmed ? 'is-dimmed' : ''}">
        <span class="live-tag">${m.status === 'live' ? 'LIVE' : 'Jetzt im Gange'}</span>
        <span class="time tabular">${escapeHtml(m.time)}</span>
        <span class="teams">${escapeHtml(m.home)} <span class="vs">–</span> ${escapeHtml(m.away)}</span>
        <span class="meta">${pillHtml(m)}</span>
        <span class="rooms">Garderobe Heim ${escapeHtml(m.garderobeHeim)} · Gast ${escapeHtml(m.garderobeGast)}</span>
      </div>`;
  }

  function upcomingRowHtml(m: Match): string {
    const dimmed = m.status === 'abgesagt';
    return `
      <div class="match-row ${dimmed ? 'match-row--dimmed' : ''}">
        <span class="time tabular">${escapeHtml(m.time)}</span>
        <span class="teams">${escapeHtml(m.home)} <span class="vs">–</span> ${escapeHtml(m.away)}</span>
        <span class="rooms">Garderobe Heim ${escapeHtml(m.garderobeHeim)} · Gast ${escapeHtml(m.garderobeGast)}</span>
        ${pillHtml(m)}
      </div>`;
  }

  function render(matches: Match[], stand: string) {
    const standEl = document.getElementById('stand');
    const content = document.getElementById('content');
    if (standEl) standEl.textContent = stand;
    if (!content) return;

    if (matches.length === 0) {
      content.innerHTML = '<p class="empty">Heute keine Spiele</p>';
      return;
    }

    const now = new Date();
    const { main, upcoming, over } = classify(matches, now);

    if (main.length === 0 && upcoming.length === 0) {
      content.innerHTML = over.length > 0
        ? '<p class="empty">Keine weiteren Spiele heute</p>'
        : '<p class="empty">Heute keine Spiele</p>';
      return;
    }

    const mainSection = main.length > 0
      ? `<section class="main-section">
          <h2 class="section-title">${main.length > 1 ? 'Jetzt im Gange' : 'Jetzt im Gange'}</h2>
          <div class="main-grid main-grid--${Math.min(main.length, 3)}">${main.map(mainCardHtml).join('')}</div>
        </section>`
      : upcoming.length > 0
        ? `<section class="main-section main-section--next">
            <h2 class="section-title">Nächstes Spiel</h2>
            <div class="main-grid main-grid--1">${mainCardHtml(upcoming[0])}</div>
          </section>`
        : '';

    const upcomingList = main.length > 0 ? upcoming : upcoming.slice(1);
    const upcomingSection = upcomingList.length > 0
      ? `<section class="upcoming-section">
          <h2 class="section-title section-title--sub">Nächste Spiele</h2>
          <div class="upcoming-rows">${upcomingList.map(upcomingRowHtml).join('')}</div>
        </section>`
      : '';

    content.innerHTML = mainSection + upcomingSection;
  }

  async function refresh() {
    try {
      const res = await fetch(`/data/matchday.json?_=${Date.now()}`, { cache: 'no-store' });
      if (!res.ok) throw new Error(`status ${res.status}`);
      const data = await res.json();
      render(data.matches, data.generatedAt);
    } catch {
      // Keep showing the last good data on a fetch failure (never a blank
      // or error screen) — the "Stand" timestamp already shows its age.
    }
  }

  function updateClock() {
    const now = new Date();
    const clock = document.getElementById('clock');
    const date = document.getElementById('date');
    if (clock) {
      clock.textContent = now.toLocaleTimeString('de-CH', {
        hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Zurich',
      });
    }
    if (date) {
      date.textContent = now.toLocaleDateString('de-CH', {
        weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Zurich',
      });
    }
  }

  const contentEl = document.getElementById('content');
  const seedJson = contentEl ? contentEl.dataset.seed : undefined;
  const seed: Match[] = seedJson ? JSON.parse(seedJson) : [];
  render(seed, (document.getElementById('stand')?.textContent ?? '').trim());

  updateClock();
  setInterval(updateClock, 1000);
  // Re-render on a shorter interval too, so a match crosses into/out of its
  // 90-minute window without waiting for the next data refresh.
  setInterval(() => render(seed, (document.getElementById('stand')?.textContent ?? '').trim()), 30_000);
  setInterval(refresh, 60_000);
</script>

<style>
  .monitor {
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding: 48px;
    position: relative;
    background:
      radial-gradient(circle at 12% -10%, rgba(217, 12, 32, 0.28), transparent 55%),
      radial-gradient(circle at 100% 115%, rgba(217, 12, 32, 0.16), transparent 50%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 2px, transparent 2px 60px),
      linear-gradient(180deg, #141414 0%, #0a0a0a 100%);
  }
  .monitor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    background: #ffffff;
    border-radius: 12px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .brand :global(img) {
    display: block;
    height: 90px;
    width: auto;
  }
  .clock-block { text-align: right; }
  .clock { font-size: 64px; font-weight: 700; font-family: var(--wsc-font-display); }
  .date { font-size: 24px; color: var(--wsc-tv-muted); }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 32px;
    justify-content: flex-start;
    min-height: 0;
    overflow: hidden;
  }

  /* Everything below targets markup injected client-side via innerHTML, so
     it must be :global() — Astro's scoping attribute is only applied to
     elements present in this component's own template at build time. */
  :global(.section-title) {
    font-size: 28px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 16px;
    color: var(--wsc-brand-primary);
  }
  :global(.section-title--sub) { color: var(--wsc-tv-muted); font-size: 22px; }

  :global(.main-grid) {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  :global(.main-grid--2) { grid-template-columns: repeat(2, 1fr); }
  :global(.main-grid--3) { grid-template-columns: repeat(3, 1fr); }

  :global(.main-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: linear-gradient(135deg, rgba(217, 12, 32, 0.22), var(--wsc-tv-row));
    border: 2px solid var(--wsc-brand-primary);
    border-radius: 16px;
    padding: 28px 32px;
    box-shadow: 0 10px 30px rgba(217, 12, 32, 0.15);
  }
  :global(.main-card.is-dimmed) { opacity: 0.55; }
  :global(.live-tag) {
    align-self: flex-start;
    background: var(--wsc-brand-primary);
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 14px;
    border-radius: 999px;
  }
  :global(.main-card .time) { font-size: 48px; font-weight: 700; }
  :global(.main-card .teams) { font-size: 36px; font-weight: 700; }
  :global(.main-card .vs) { color: var(--wsc-tv-muted); }
  :global(.main-card .meta) { display: flex; gap: 12px; flex-wrap: wrap; }
  :global(.main-card .rooms) { font-size: 20px; color: var(--wsc-tv-muted); }

  :global(.upcoming-rows) { display: flex; flex-direction: column; gap: 14px; }
  :global(.upcoming-rows .match-row) {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--wsc-tv-row);
    border-left: 6px solid transparent;
    border-radius: 8px;
    padding: 14px 24px;
    font-size: 24px;
  }
  :global(.upcoming-rows .match-row--dimmed) { opacity: 0.5; }
  :global(.upcoming-rows .time) { font-size: 32px; font-weight: 700; min-width: 3.5ch; }
  :global(.upcoming-rows .teams) { font-weight: 600; flex: 1 1 auto; }
  :global(.upcoming-rows .vs) { color: var(--wsc-tv-muted); }
  :global(.upcoming-rows .rooms) { font-size: 18px; color: var(--wsc-tv-muted); }
  :global(.upcoming-rows .hint) { font-size: 16px; font-weight: 700; color: var(--wsc-warning); }

  :global(.pill) {
    display: inline-flex;
    align-items: center;
    padding: 4px 16px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
  }
  :global(.pill--natural) { background: var(--wsc-pitch-natural); }
  :global(.pill--artificial) { background: var(--wsc-pitch-artificial); }
  :global(.pill--success) { background: var(--wsc-success); }
  :global(.pill--warning) { background: var(--wsc-warning); }
  :global(.pill--danger) { background: var(--wsc-danger); }

  :global(.empty) {
    margin: auto;
    text-align: center;
    font-size: 48px;
    color: var(--wsc-tv-muted);
  }
  .stand {
    text-align: right;
    font-size: 18px;
    color: var(--wsc-tv-muted);
    margin-top: 24px;
  }
</style>

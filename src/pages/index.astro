---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import jubilaeumTeaser from '../assets/brand/70-jahre-wsc.jpg';
import { getCollection, type CollectionEntry } from 'astro:content';
import matchday from '../../public/data/matchday.json';

const newsEntries: CollectionEntry<'news'>[] = await getCollection('news');
const news = newsEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const todaysMatches = matchday.matches.slice(0, 4);

const teamCategories = [
  { label: 'Aktive', href: '/mannschaften#aktive' },
  { label: 'Senioren', href: '/mannschaften#senioren' },
  { label: 'Junioren*innen', href: '/mannschaften#junioren' },
  { label: 'Mädchen', href: '/mannschaften#maedchen' },
];
---
<BaseLayout title="Willkommen" description="Der Weggiser Sportclub legt grossen Wert darauf, dass sich die Teams aus Einheimischen der Seegemeinden zusammensetzen und investiert sehr viel in die Nachwuchsförderung.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Weggiser Sportclub</p>
      <h1>Der Fussballclub der Seegemeinden</h1>
      <p class="lead">Gegründet 1955. Von den Junioren G bis zu den Senioren 30+ – zuhause auf der Thermoplan Arena und der Black&amp;White Arena.</p>
      <div class="hero-actions">
        <a class="btn" href="/mannschaften">Unsere Mannschaften</a>
        <a class="btn btn--outline" href="/verein">Verein &amp; Vorstand</a>
      </div>
    </div>
  </section>

  <section class="wrap jubilee-section">
    <a href="/70-jahre-weggiser-sportclub" class="jubilee">
      <div class="jubilee-media">
        <Image src={jubilaeumTeaser} alt="70 Jahre Weggiser Sportclub" width={520} height={300} />
      </div>
      <div class="jubilee-body">
        <span class="badge">Jubiläumssaison 2025/26</span>
        <h2>70 Jahre Weggiser Sportclub</h2>
        <p>Seit 1955 der Fussballclub der Seegemeinden. Wir feiern die ganze Saison – mehr zu Geschichte und Festlichkeiten.</p>
        <span class="jubilee-link">Mehr erfahren →</span>
      </div>
    </a>
  </section>

  {todaysMatches.length > 0 && (
    <section class="wrap today-section">
      <div class="today-head">
        <h2>Heute auf der Arena</h2>
        <a href="/arena">Alle Spiele →</a>
      </div>
      <div class="today-list">
        {todaysMatches.map((m) => (
          <div class={`today-row ${m.status === 'abgesagt' ? 'today-row--dimmed' : ''}`}>
            <span class="time tabular">{m.time}</span>
            <span class="teams">{m.home} <span class="vs">–</span> {m.away}</span>
            <span class="field">{m.field}</span>
            {m.status && <span class={`pill pill--${m.status === 'live' ? 'success' : m.status === 'verschoben' ? 'warning' : 'danger'}`}>
              {m.status === 'live' ? 'LIVE' : m.status === 'verschoben' ? 'Verschoben' : 'Abgesagt'}
            </span>}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap">
    <div class="section-head">
      <h2>Aktuelles</h2>
      <a href="/aktuelles">Alle Meldungen →</a>
    </div>
    <div class="news-grid">
      {news.map((post) => (
        <a href={`/aktuelles/${post.id}`} class="card news-card">
          <time class="tabular">{post.data.date.toLocaleDateString('de-CH')}</time>
          <h3>{post.data.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap teams-section">
    <h2>Unsere Mannschaften</h2>
    <p class="lead-small">Von den Junioren G bis zu den Senioren 30+ – für jedes Alter das passende Team.</p>
    <div class="team-pill-grid">
      {teamCategories.map((cat) => (
        <a class="team-pill" href={cat.href}>{cat.label}</a>
      ))}
    </div>
  </section>

  <section class="wrap arenas">
    <h2>Unsere Plätze</h2>
    <div class="arena-grid">
      <div class="card">
        <h3>Thermoplan Arena</h3>
        <p>Naturrasen, 105 × 68 m. Hauptfeld, 1.-Liga-Lizenz, 200 Sitz- / 1050 Stehplätze.</p>
      </div>
      <div class="card">
        <h3>Black&amp;White Arena</h3>
        <p>Kunstrasen, 100 × 64 m. Allwetterplatz für 2.-Liga-interregional – keine Stollenschuhe.</p>
      </div>
    </div>
    <p><a href="/arena">Mehr zur Arena →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--wsc-surface);
    padding: var(--wsc-space-8) 0;
    border-bottom: 1px solid var(--wsc-line);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wsc-brand-primary);
    font-weight: 700;
    font-size: var(--wsc-step--1);
  }
  .lead { max-width: 640px; color: var(--wsc-muted); font-size: var(--wsc-step-1); }
  .lead-small { color: var(--wsc-muted); margin-top: -0.5rem; }
  .hero-actions { display: flex; gap: var(--wsc-space-2); margin-top: var(--wsc-space-3); flex-wrap: wrap; }
  .btn--outline {
    background: transparent;
    color: var(--wsc-brand-primary);
    border: 2px solid var(--wsc-brand-primary);
  }
  section.wrap { padding: var(--wsc-space-6) var(--wsc-space-3); }

  .section-head, .today-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wsc-space-2);
    flex-wrap: wrap;
  }
  .section-head h2, .today-head h2 { margin: 0; }
  .section-head a, .today-head a { font-weight: 600; white-space: nowrap; }

  .news-grid, .arena-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--wsc-space-3);
    margin-top: var(--wsc-space-3);
  }
  .news-card { text-decoration: none; color: var(--wsc-ink); }
  .news-card time { font-size: var(--wsc-step--1); color: var(--wsc-muted); }

  /* Jubilee */
  .jubilee-section { padding-bottom: 0; }
  .jubilee {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: var(--wsc-space-4);
    align-items: center;
    text-decoration: none;
    background: var(--wsc-surface);
    border: 1px solid var(--wsc-line);
    border-radius: var(--wsc-radius);
    overflow: hidden;
    transition: box-shadow 0.15s ease;
  }
  .jubilee:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); text-decoration: none; }
  @media (max-width: 640px) {
    .jubilee { grid-template-columns: 1fr; }
  }
  .jubilee-media :global(img) {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
  }
  .jubilee-body { padding: var(--wsc-space-3) var(--wsc-space-4) var(--wsc-space-3) 0; }
  @media (max-width: 640px) {
    .jubilee-body { padding: 0 var(--wsc-space-3) var(--wsc-space-3); }
  }
  .jubilee-body h2 { margin: 0.3rem 0; }
  .jubilee-body p { color: var(--wsc-muted); margin: 0 0 0.6rem; }
  .jubilee-link { color: var(--wsc-brand-primary); font-weight: 700; }
  .badge {
    display: inline-block;
    background: var(--wsc-brand-primary);
    color: #fff;
    font-size: var(--wsc-step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2em 0.75em;
    border-radius: var(--wsc-radius-pill);
  }

  /* Today */
  .today-section { padding-top: var(--wsc-space-4); }
  .today-list { display: grid; gap: var(--wsc-space-2); margin-top: var(--wsc-space-3); }
  .today-row {
    display: flex;
    align-items: center;
    gap: var(--wsc-space-3);
    flex-wrap: wrap;
    background: var(--wsc-surface);
    border: 1px solid var(--wsc-line);
    border-left: 4px solid var(--wsc-brand-primary);
    border-radius: var(--wsc-radius);
    padding: var(--wsc-space-2) var(--wsc-space-3);
  }
  .today-row--dimmed { opacity: 0.55; border-left-color: var(--wsc-muted); }
  .today-row .time { font-weight: 700; min-width: 4ch; }
  .today-row .teams { font-weight: 600; flex: 1 1 auto; }
  .today-row .vs { color: var(--wsc-muted); }
  .today-row .field { font-size: var(--wsc-step--1); color: var(--wsc-muted); }

  /* Teams */
  .team-pill-grid { display: flex; flex-wrap: wrap; gap: var(--wsc-space-2); margin-top: var(--wsc-space-2); }
  .team-pill {
    display: inline-block;
    padding: 0.6em 1.4em;
    border-radius: var(--wsc-radius-pill);
    background: var(--wsc-brand-secondary);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .team-pill:hover { background: var(--wsc-brand-primary); text-decoration: none; }
</style>

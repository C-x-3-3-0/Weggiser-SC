---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const vorstandEntries: CollectionEntry<'vorstand'>[] = await getCollection('vorstand');
const vorstand = vorstandEntries.sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Vorstand">
  <section class="wrap">
    <p class="eyebrow">Verein</p>
    <h1>Vorstand</h1>
    <p class="lead">Die Mitglieder des Vorstands leiten den Weggiser Sportclub ehrenamtlich.</p>
    <div class="roster-grid">
      {vorstand.map((member) => (
        <PersonCard name={member.data.name} role={member.data.role} />
      ))}
    </div>
    <p><a href="/verein">← Zurück zu Verein</a></p>
  </section>
</BaseLayout>

<style>
  section.wrap { padding: var(--wsc-space-6) var(--wsc-space-3); max-width: 900px; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wsc-brand-primary);
    font-weight: 700;
    font-size: var(--wsc-step--1);
    margin: 0;
  }
  .lead { color: var(--wsc-muted); max-width: 560px; }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--wsc-space-4) var(--wsc-space-2);
    margin: var(--wsc-space-4) 0;
  }
</style>

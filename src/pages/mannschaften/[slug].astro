---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPhotoPlaceholder from '../../components/TeamPhotoPlaceholder.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const teams: CollectionEntry<'teams'>[] = await getCollection('teams');
  return teams.map((team) => ({
    params: { slug: team.id },
    props: { team },
  }));
}

interface Props {
  team: CollectionEntry<'teams'>;
}

const { team } = Astro.props as Props;
const { Content } = await render(team);
const { coaches, players, photoCaption } = team.data;
---
<BaseLayout title={team.data.name}>
  <article class="wrap">
    <p class="category">{team.data.category}</p>
    <h1>{team.data.name}</h1>

    <figure class="team-photo">
      <TeamPhotoPlaceholder label={team.data.name} />
      <figcaption>{photoCaption ?? 'Teamfoto folgt – Bildbeschreibung wird ergänzt, sobald das Foto vorliegt.'}</figcaption>
    </figure>

    <div class="content">
      <Content />
    </div>

    {team.data.ifvTeamId && (
      <p>
        <a
          href={`https://matchcenter.ifv.ch/default.aspx?v=381&oid=7&lng=1&t=${team.data.ifvTeamId}&a=trr`}
          rel="noopener"
        >Spielplan &amp; Rangliste im IFV Matchcenter →</a>
      </p>
    )}

    {coaches.length > 0 && (
      <section class="roster">
        <h2>Trainer*innen</h2>
        <div class="roster-grid">
          {coaches.map((name: string) => <PersonCard name={name} role="Trainer*in" />)}
        </div>
      </section>
    )}

    {players.length > 0 && (
      <section class="roster">
        <h2>Spieler*innen</h2>
        <div class="roster-grid">
          {players.map((name: string) => <PersonCard name={name} role="Spieler*in" />)}
        </div>
      </section>
    )}

    <p><a href="/mannschaften">← Zurück zu Mannschaften</a></p>
  </article>
</BaseLayout>

<style>
  article.wrap { padding: var(--wsc-space-6) var(--wsc-space-3); max-width: 900px; }
  .category { text-transform: uppercase; letter-spacing: 0.05em; color: var(--wsc-muted); font-size: var(--wsc-step--1); margin: 0; }
  .content { margin: var(--wsc-space-3) 0; }

  .team-photo { margin: var(--wsc-space-3) 0 var(--wsc-space-4); }
  .team-photo figcaption {
    margin-top: var(--wsc-space-1);
    font-size: var(--wsc-step--1);
    color: var(--wsc-muted);
    font-style: italic;
  }

  .roster { margin-top: var(--wsc-space-6); }
  .roster h2 { border-bottom: 2px solid var(--wsc-line); padding-bottom: 0.4rem; }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--wsc-space-4) var(--wsc-space-2);
    margin-top: var(--wsc-space-3);
  }
</style>
